# Copy to .env for local development. Never commit real secrets.

# Postgres (matches docker-compose.yml). Use 127.0.0.1, not "localhost":
# the container binds the IPv4 loopback only, and "localhost" resolves to ::1 first.
BRIER_DATABASE_URL=postgresql://brier:brier@127.0.0.1:5432/brier

# External integrations — unused in the skeleton; all integrations are
# mock-first (fixture-backed fakes) until their epic lands. See TASKS.md.
YOUTUBE_API_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
COINGECKO_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
