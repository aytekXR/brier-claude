# Brier web app — systemd unit (production). Supervises `next start` on :3000.
#
# Replaces the @reboot user-cron + ~/brier-web-start.sh launcher with a
# supervised service: auto-restart on failure + survives reboot. The shared
# Caddy (pulse-prod-caddy-1) reverse-proxies brier.beyondkaira.com ->
# 161.97.172.146:3000, so the listen host/port below MUST stay :3000.
#
# Env comes from ONE source shared with the worker: /etc/brier/brier.env
# (root-owned, chmod 600). Without it the web process silently drops dispute
# email + newsletter signups (it falls back to FakeNotifier/FakeSubscriber when
# BRIER_RESEND_API_KEY / BRIER_BUTTONDOWN_API_KEY are unset). NOTE:
# NEXT_PUBLIC_SITE_URL is baked into .next at BUILD time — setting it here only
# covers server-side reads; run `make web-build` to change the public origin.
#
# CRITICAL — node lives under nvm (/home/aytek/.local/bin/node ->
# ~/.nvm/.../node), which is NOT on systemd's default PATH. The `next` shim is
# `#!/usr/bin/env node`, so without the Environment=PATH line below the unit
# fails to start ("env: node: No such file or directory"). Keep that line.
#
# SECURITY — `-H 0.0.0.0` is required (the shared Caddy reaches this app via the host's PUBLIC
# IP from inside a container, so it cannot bind 127.0.0.1). That leaves :3000 reachable from the
# internet (raw app, no TLS) until you firewall it — see INSTALL.md step 5b.
#
# Install (see deploy/INSTALL.md for the full host runbook):
#   1) /etc/brier/brier.env must exist (chmod 600) — see INSTALL.md step 3.
#   2) sudo cp deploy/brier-web.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now brier-web
#   3) crontab -e   # delete the "@reboot ... brier-web-start.sh" line (no double-start)
#   4) curl -fsS https://brier.beyondkaira.com/api/health   # expect {"status":"ok"}

[Unit]
Description=Brier web app (next start :3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aytek
WorkingDirectory=/home/aytek/repo/brier-claude/apps/web
EnvironmentFile=/etc/brier/brier.env
# nvm node is not on the systemd default PATH; prepend the user's bin dir so the
# `#!/usr/bin/env node` shebang in node_modules/.bin/next resolves.
Environment=PATH=/home/aytek/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/aytek/repo/brier-claude/apps/web/node_modules/.bin/next start -p 3000 -H 0.0.0.0
Restart=on-failure
RestartSec=5
# Hardening. ProtectHome=read-only (not =true) because WorkingDirectory + node
# live under /home; ReadWritePaths re-grants write for the Next data cache
# (.next/cache). If `next start` ever fails to write its cache, relax this.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/home/aytek/repo/brier-claude/apps/web

[Install]
WantedBy=multi-user.target
