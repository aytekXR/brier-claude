# Brier — PRODUCTION env template. Copy to a chmod-600 file on the host and fill in.
#   Worker host:  sudo install -m600 /dev/null /etc/brier/brier.env  (then edit)
#   Web host:     apps/web/.env.production.local  (Next.js auto-loads it; gitignored)
# NEVER commit real values. CI/dev stay mock-first — none of these are set there.
# Empty/unset keys fall back to the fixture-backed fakes; BRIER_ENV=production turns
# the silent-fixture guards into hard errors (see jobs/handlers.py, transcriber.py).

# ---- Deployment mode -------------------------------------------------------
# Unset/"dev" in CI/dev (fakes are the default). Set to "production" on real hosts
# so the price-source / transcriber seams refuse to fall back to fixtures.
BRIER_ENV=production

# ---- Database (NOT a secret to guard the same way, but host-specific) -------
BRIER_DATABASE_URL=postgresql://brier:brier@localhost:5432/brier

# ---- Required API keys -----------------------------------------------------
# LLM extraction (Anthropic, stdlib REST, ADR-0005). Also used to re-run the
# AC-1/G2 golden gate on real model output before GO.
BRIER_ANTHROPIC_API_KEY=
# Extraction model — Haiku-class default (claude-haiku-4-5-20251001); override only
# with human approval. Leave unset to use the pinned default (config.extraction_model).
BRIER_EXTRACTION_MODEL=
# YouTube Data API v3 — poller (FR-102) + deletion sweep (EC-1/AC-6). Provision quota.
BRIER_YOUTUBE_API_KEY=
# CoinGecko — prices -> resolution + base rates (ADR-0009). EFFECTIVELY REQUIRED:
# without it, BRIER_ENV=production refuses to score (would otherwise use fixtures).
BRIER_COINGECKO_API_KEY=

# ---- Transcription ---------------------------------------------------------
# Incremental uploads (Deepgram REST, no SDK). Backfill uses Whisper on the GPU
# host (ADR-0003) and needs NO key. get_transcriber() picks the adapter.
BRIER_DEEPGRAM_API_KEY=

# ---- Web host integrations (set in apps/web/.env.production.local) ----------
# Public site origin — drives metadataBase, canonical/OG URLs, sitemap, robots,
# JSON-LD (lib/site.ts). MUST be set in production; no trailing slash.
NEXT_PUBLIC_SITE_URL=https://brier.beyondkaira.com
# Dispute ticket + adjudication email (Resend, ADR-0010). FROM/fallback address
# defaults to disputes@brier.beyondkaira.com; override only if the domain differs.
# The sending domain must be verified in Resend (SPF/DKIM) for delivery.
BRIER_RESEND_API_KEY=
BRIER_DISPUTE_FROM_EMAIL=disputes@brier.beyondkaira.com
# Newsletter / waitlist double-opt-in (Buttondown, ADR-0013).
BRIER_BUTTONDOWN_API_KEY=

# ---- QA review queue (FR-203) ----------------------------------------------
# Label Studio for human review of low-confidence extractions. Leave unset to use
# the in-memory queue (then a documented manual-review step is required).
BRIER_LABEL_STUDIO_URL=
BRIER_LABEL_STUDIO_TOKEN=

# ---- Monitoring / alerting (set at least one; ADR-0014) --------------------
BRIER_BETTER_STACK_TOKEN=
BRIER_SENTRY_DSN=

# ---- R2 object storage (transcripts persist; audio 30-day TTL; ADR-0004) ---
# Names mirror .env.example; wiring lands when ADR-0004 is approved.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- Spend caps (NFR-5) — set to the REAL backfill-month budget before drain -
# Defaults: 700 / 300 / 0.70 (70% alert). Calibrate with a single-channel pilot.
BRIER_TRANSCRIPTION_MONTHLY_CAP_USD=700.0
BRIER_LLM_MONTHLY_CAP_USD=300.0
BRIER_SPEND_ALERT_FRACTION=0.70
